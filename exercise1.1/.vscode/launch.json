{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run CampusFlow",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "console": "integratedTerminal",
      "env": {
        "PORT": "5051"
      },
      "serverReadyAction": {
        "pattern": "Running on (http://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ]
}
